# Supabase project settings → API
# Use the project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key — safe for the browser. Never put a secret or
# service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: the public origin used in auth email redirect links and metadata.
# Defaults to http://localhost:3000. Set this in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, server-only: secret (service-role) key used to persist public
# catalogue metadata in the shared `catalog_cache` table. Without it the cache
# is in-memory best-effort per server instance (see README).
# Never expose this value in a NEXT_PUBLIC_ variable and never use it in the
# browser.
SUPABASE_SERVICE_ROLE_KEY=
